{
    "$schema":  "https://schema.tauri.app/config/2",
    "productName":  "BhojPatra Desk",
    "version":  "0.1.21",
    "identifier":  "com.bhojpatra.desk",
    "build":  {
                  "frontendDist":  "../dist",
                  "devUrl":  "http://localhost:5173",
                  "beforeDevCommand":  "corepack pnpm dev",
                  "beforeBuildCommand":  "corepack pnpm build"
              },
    "app":  {
                "windows":  [
                                {
                                    "label":  "main",
                                    "title":  "BhojPatra Desk",
                                    "width":  1480,
                                    "height":  920,
                                    "minWidth":  1080,
                                    "minHeight":  720,
                                    "center":  true,
                                    "resizable":  true,
                                    "fullscreen":  false
                                }
                            ],
                "security":  {
                                 "csp":  null
                             }
            },
    "bundle":  {
                   "active":  true,
                   "createUpdaterArtifacts":  true,
                   "targets":  "all",
                   "icon":  [
                                "icons/32x32.png",
                                "icons/128x128.png",
                                "icons/icon.png",
                                "icons/128x128@2x.png",
                                "icons/icon.icns",
                                "icons/icon.ico"
                            ],
                   "windows":  {
                                   "nsis":  {
                                                "installerHooks":  "windows/bhojpatra-firewall.nsh"
                                            },
                                   "webviewInstallMode":  {
                                                              "type":  "embedBootstrapper",
                                                              "silent":  true
                                                          }
                               }
               },
    "plugins":  {
                    "updater":  {
                                    "pubkey":  "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEU3OUQ0QjhENkZDQjg2OEEKUldTS2hzdHZqVXVkNXlqaGlxUnFGeGtUd05JZE1OaXVZRUZ5RTIrSk5sL05UV0FuRk1aK2VObm8K",
                                    "endpoints":  [
                                                      "https://pub-99fc5ebb1fb24ce9a69d861fc420f8b2.r2.dev/latest.json"
                                                  ],
                                    "windows":  {
                                                    "installMode":  "passive"
                                                }
                                }
                }
}
